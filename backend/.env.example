## Backend Environment Variables (copy to `.env` in this folder)

# DATABASE
# URL do PostgreSQL (produção) ou banco remoto equivalente.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# JWT
JWT_SECRET="change-me"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# Server / CORS
PORT=3000
# Lista separada por vírgula. FRONTEND_URL é sempre acrescentada automaticamente à lista.
CORS_ORIGIN="http://localhost:5173"
# URL do site (Vercel). Obrigatório em produção — usada também no CORS.
FRONTEND_URL="http://localhost:5173"
# Opcional: permitir previews Vercel (*.vercel.app) sem listar cada URL
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Stripe (optional - billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SMART_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# OpenAI (optional - AI features)
OPENAI_API_KEY=

# Email (optional - password reset + confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

