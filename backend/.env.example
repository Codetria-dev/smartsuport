## Backend Environment Variables (copy to `.env` in this folder)

# DATABASE
# URL do PostgreSQL (produção) ou banco remoto equivalente.
# NOTA: não use aspas nos valores no dashboard da Railway/Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# JWT (sem aspas — jsonwebtoken aceita formato "15m", "7d", "1h", 3600)
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Server / CORS
PORT=3000
# Lista separada por vírgula. FRONTEND_URL é sempre acrescentada automaticamente à lista.
CORS_ORIGIN=http://localhost:5173
# URL do site (Vercel). Obrigatório em produção — usada também no CORS.
FRONTEND_URL=http://localhost:5173
# Opcional: permitir previews Vercel (*.vercel.app) sem listar cada URL
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Stripe (optional - billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SMART_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# OpenAI (optional - AI features)
OPENAI_API_KEY=

# Email (optional - password reset + confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Opcional: força TLS. Se omitido, true quando porta=465, false caso contrário.
# SMTP_SECURE=true

# Encryption (obrigatório se usar AI features com apiKey do usuário)
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

